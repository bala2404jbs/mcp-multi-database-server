# Environment configuration
# Copy this file to .env and update with your values

# Path to database configuration file
DATABASE_CONFIG_PATH=/absolute/path/to/databases.json

# Path to users configuration file (optional - if not set, access control is disabled)
USERS_CONFIG_PATH=/absolute/path/to/users.json

# Audit log file path (optional - defaults to ./audit.log)
AUDIT_LOG_PATH=/absolute/path/to/audit.log

# Log level: debug, info, warn, error (defaults to info)
LOG_LEVEL=info
